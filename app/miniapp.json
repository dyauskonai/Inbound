{
  "$schema": "./node_modules/@mentra/miniapp-cli/schema/miniapp.schema.json",
  "packageName": "com.inbound.capture",
  "version": "0.2.0",
  "name": "Inbound",
  "description": "Voice-controlled audio, photo capture, and AI handoff reports.",
  "icon": "icon.png",
  "type": "standard",
  "sdkVersion": "3.4.0",
  "minHostVersion": "1.42.0",
  "entry": {
    "background": "background/index.js",
    "ui": "ui/index.html"
  },
  "permissions": [
    {
      "type": "MICROPHONE",
      "description": "Record the handoff and recognize start, snap, and stop anywhere in a sentence."
    },
    {
      "type": "CAMERA",
      "description": "Take photos for your handoff report."
    }
  ],
  "hardwareRequirements": [
    {
      "type": "CAMERA",
      "level": "REQUIRED"
    },
    {
      "type": "MICROPHONE",
      "level": "REQUIRED"
    }
  ]
}
