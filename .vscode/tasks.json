{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Inbound: Mac server",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["scripts/dev.py", "--lan"],
      "options": {"cwd": "${workspaceFolder}"},
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated"}
    },
    {
      "label": "Inbound: Mentra MiniApp",
      "type": "process",
      "command": "${workspaceFolder}/runtime/bin/bun",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/app",
        "env": {"PATH": "${workspaceFolder}/runtime/bin:${env:PATH}"}
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated"}
    },
    {
      "label": "Inbound: test backend",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "pytest", "-q"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
